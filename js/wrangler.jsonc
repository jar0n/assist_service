/*
 * Cloudflare Workers configuration for Assist Service
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "assist-service-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-05-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "AssistContainer",
			"image": "../Dockerfile.cloudflare",
			"max_instances": 10,
			"name": "assist-service-container"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AssistContainer",
				"name": "ASSIST_CONTAINER"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"AssistContainer"
			],
			"tag": "v1"
		}
	]
}
